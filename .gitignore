# Node modules
node_modules/

# Local utility scripts
*.bat
*.cmd
*.ps1
extract-zip
mkdirp
mime
browsers

# Secrets (Jira email + API token, Gmail app password) — ignored in any folder, never commit
jira_credentials.json
email_credentials.json

# Web Legacy Emails deploy-sync launcher is part of the module (overrides *.bat above)
!web_legacy_emails/deploy/sync_push.bat
!web_legacy_emails/deploy/sync_pull.bat
# Local sync state (snapshot of GitHub's history at the last pull)
web_legacy_emails/deploy/last_pull_snapshot.json

# Web Legacy Emails local run outputs (scheduler run log, dry-run email preview)
web_legacy_emails/schedule_runs.json
web_legacy_emails/last_scheduled_preview.html

# Logs
npm-debug.log*

# OS Files
.DS_Store
Thumbs.db
